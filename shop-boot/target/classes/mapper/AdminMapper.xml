<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.shop.mapper.AdminMapper">

    <resultMap id="BaseResultMap" type="com.example.shop.entity.Admin">
        <id column="aid" jdbcType="INTEGER" property="adminId"/>
        <result column="username" jdbcType="VARCHAR" property="username"/>
        <result column="password" jdbcType="VARCHAR" property="password"/>
    </resultMap>

    <sql id="Base_Column_List">
        aid, username, password
    </sql>

    <!-- 根据主键查询管理员 -->
    <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM zk_admin
        WHERE aid = #{adminId,jdbcType=INTEGER}
    </select>

    <!-- 根据用户名和密码查询管理员(登录) -->
    <select id="findByUsernameAndPassword" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM zk_admin
        WHERE username = #{username,jdbcType=VARCHAR}
          AND password = #{password,jdbcType=VARCHAR}
    </select>

    <!-- 根据用户名查询管理员 -->
    <select id="findByUsername" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM zk_admin
        WHERE username = #{username,jdbcType=VARCHAR}
    </select>

    <!-- 根据主键删除管理员 -->
    <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
        DELETE
        FROM zk_admin
        WHERE aid = #{adminId,jdbcType=INTEGER}
    </delete>

    <!-- 插入管理员(全字段) -->
    <insert id="insert" parameterType="com.example.shop.entity.Admin" useGeneratedKeys="true" keyProperty="adminId">
        INSERT INTO zk_admin (aid, username, password)
        VALUES (#{adminId,jdbcType=INTEGER}, #{username,jdbcType=VARCHAR}, #{password,jdbcType=VARCHAR})
    </insert>

    <!-- 插入管理员(选择性) -->
    <insert id="insertSelective" parameterType="com.example.shop.entity.Admin" useGeneratedKeys="true"
            keyProperty="adminId">
        INSERT INTO zk_admin
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="adminId != null">aid,</if>
            <if test="username != null">username,</if>
            <if test="password != null">password,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="adminId != null">#{adminId,jdbcType=INTEGER},</if>
            <if test="username != null">#{username,jdbcType=VARCHAR},</if>
            <if test="password != null">#{password,jdbcType=VARCHAR},</if>
        </trim>
    </insert>

    <!-- 根据主键更新管理员(选择性) -->
    <update id="updateByPrimaryKeySelective" parameterType="com.example.shop.entity.Admin">
        UPDATE zk_admin
        <set>
            <if test="username != null">username = #{username,jdbcType=VARCHAR},</if>
            <if test="password != null">password = #{password,jdbcType=VARCHAR},</if>
        </set>
        WHERE aid = #{adminId,jdbcType=INTEGER}
    </update>

    <!-- 根据主键更新管理员(全字段) -->
    <update id="updateByPrimaryKey" parameterType="com.example.shop.entity.Admin">
        UPDATE zk_admin
        SET username = #{username,jdbcType=VARCHAR},
            password = #{password,jdbcType=VARCHAR}
        WHERE aid = #{adminId,jdbcType=INTEGER}
    </update>

</mapper>
